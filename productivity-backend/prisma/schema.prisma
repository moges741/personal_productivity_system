datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"                  
  output   = "../src/generated/prisma-client"  
  moduleFormat = "esm"                             
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String?  
  name            String?
  avatarUrl       String?
  timezone        String   @default("UTC")
  preferences     Json     @default("{}")   
  isVerified      Boolean  @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  refreshTokens   RefreshToken[]
  tasks           Task[]
  notes           Note[]
  habits          Habit[]
  //calendarEvents  CalendarEvent[]

  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  hashedToken String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@map("refresh_tokens")
}
model Note {
  id         String   @id @default(cuid())
  title      String?
  content    String?
  color      String?  @default("#ffffff")
  isPinned   Boolean  @default(false)
  isArchived Boolean  @default(false)
  isDeleted  Boolean  @default(false)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ownerId    String
  owner      User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  attachments Attachment[]

  @@index([ownerId])
  @@index([isPinned])
  @@index([isArchived])
  @@index([isDeleted])
  @@map("notes")
}

model Attachment {
  id           String   @id @default(cuid())
  fileName     String
  originalName String
  mimeType     String
  size         Int
  path         String
  url          String?
  noteId       String

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  note         Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@map("attachments")
}


enum TaskStatus {
  todo
  in_progress
  done
}

enum TaskPriority {
  low
  medium
  high
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(todo)
  priority    TaskPriority @default(medium)
  dueDate     DateTime?
  isPinned    Boolean      @default(false)
  isArchived  Boolean      @default(false)
  isDeleted   Boolean      @default(false)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum HabitFrequency {
  daily
  weekly
  custom   
}

enum HabitCategory {
  health
  fitness
  productivity
  learning
  mindfulness
  finance
  social
  creativity
  other
}

model Habit {
  id              String         @id @default(cuid())
  name            String
  description     String?

  frequency       HabitFrequency @default(daily)

  // For custom frequency: store days as JSON array e.g. [1,3,5] = Mon/Wed/Fri
  // 0 = Sunday ... 6 = Saturday (JS Date.getDay() convention)
  customDays      Int[]          @default([])

  targetCount     Int            @default(1)    
  currentStreak   Int            @default(0)
  bestStreak      Int            @default(0)

  reminderTime    String?

  color           String         @default("#6366f1")  
  icon            String?        
  category        HabitCategory  @default(other)

  lastCompletedAt DateTime?
  isArchived      Boolean        @default(false)
  isDeleted       Boolean        @default(false)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Future: completions history table will relate here
  completions     HabitCompletion[]
}

// ── HabitCompletion model (add now, use later) ─────────────────────────────
model HabitCompletion {
  id          String   @id @default(cuid())
  completedAt DateTime @default(now())
  note        String?  // optional "how did it go?" note

  habitId     String
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
}